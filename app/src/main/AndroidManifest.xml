<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Content sync with Firebase Hosting (HTTPS); the app works offline with the bundled content -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sign in with Google: tells "no connection" apart before opening the account picker -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- No CAMERA permission: photos come from the Photo Picker or the camera app (TakePicture).
         The query lets the app tell whether a camera app exists (API 30+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".TioMinuterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TioMinuterMVI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TioMinuterMVI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares only the camera capture file (cache/training_photo_capture/) with the camera app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.trainingphotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/training_photo_paths" />
        </provider>
    </application>

</manifest>